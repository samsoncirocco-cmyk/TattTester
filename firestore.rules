rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User designs — owner access only
    match /users/{userId}/designs/{designId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /versions/{versionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /layers/{layerId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // User preferences — owner access only
    match /users/{userId}/preferences/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Booking requests — written server-side only (Admin SDK via
    // /api/v1/book). A signed-in user may read only their own requests
    // (docs carry the owner uid). No client writes, ever.
    match /booking_requests/{bookingId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Artist availability — one doc per artist, maintained server-side.
    // Missing doc means "unknown" (UI: "availability on request").
    // Readable by signed-in users; no client writes.
    //
    // This document now also carries the artist's own `schedule` and
    // `overrides` (the windows they offer TatT). Writes STILL do not happen
    // here: they go through PUT /api/v1/artist/availability, which proves
    // `claimedByUid` first. A client-writable schedule would let anyone publish
    // bookable time on someone else's profile.
    match /artist_availability/{artistId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Calendar connections — encrypted Google refresh tokens. Server only,
    // and not readable either: this is the one collection holding a live
    // credential for a third-party account. The non-secret summary reaches the
    // artist through GET /api/v1/artist/calendar/connect.
    match /artist_calendar_connections/{artistId} {
      allow read, write: if false;
    }

    // OAuth state — single-use CSRF tokens for the calendar connect flow.
    // A readable state token is a forgeable callback.
    match /calendar_oauth_states/{state} {
      allow read, write: if false;
    }

    // Slot holds — exclusive claims on an artist's time. Server only: a client
    // that could write one could reserve an artist's entire month, and one that
    // could delete one could steal a slot out from under whoever holds it.
    match /booking_holds/{holdId} {
      allow read, write: if false;
    // Shared design links — written server-side only (Admin SDK via
    // /api/v1/designs/share, which records the owner uid on the doc).
    // Opening a share link is the product feature, so a single-doc `get`
    // is public; `list` stays denied so the collection can never be
    // enumerated by anyone holding the client key. Reads today go through
    // the Admin SDK (which bypasses rules) — this entry is the standing
    // contract for any future direct client read.
    match /shared_designs/{shareId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Swipe decisions (spec 13) — a customer's pins and passes, keyed by
    // uid. Personal taste data: never readable by other clients, never
    // written except through /api/v1/match/decision (Admin SDK).
    match /match_decisions/{decisionId} {
      allow read, write: if false;
    }

    // Deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

