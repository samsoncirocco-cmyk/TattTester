# TatTester Environment Configuration
#
# GENERATED FILE — do not edit by hand. The source of truth is
# src/config/envSchema.js; regenerate with `npm run env:example`
# (CI runs `npm run env:check` and fails on drift).
#
# Every variable below is read by code in src/, scripts/, or execution/ unless
# a comment says otherwise. Placeholder values only — never commit real secrets.

# ==========================================
# CORE APP
# ==========================================

# Public app URL used to build Stripe success/cancel/return URLs and OAuth callbacks.
NEXT_PUBLIC_APP_URL=https://tatttester.com

# Base URL for shareable design links (src/app/api/v1/designs/share/route.ts).
NEXT_PUBLIC_BASE_URL=https://tatttester.com

# Demo mode (uses mock images instead of real API calls).
NEXT_PUBLIC_DEMO_MODE=false

# Logger level (src/lib/logger.ts): debug | info | warn | error.
LOG_LEVEL=info

# Allowed CORS origins (comma-separated, read by src/proxy.ts).
ALLOWED_ORIGINS=http://localhost:3000

# Canonical host redirect (src/proxy.ts, src/app/layout.tsx).
CANONICAL_HOST=

# Legacy image2ink host served by src/proxy.ts.
IMAGE2INK_HOST=

# Browser-to-API requests use Firebase ID tokens. Do not add a shared
# NEXT_PUBLIC_* authentication secret; public variables ship to browsers.

# ==========================================
# FIREBASE
# ==========================================

# Client-side Firebase config (safe to expose).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-side admin config (keep secret). Either the three discrete values or
# the full service-account JSON (src/lib/firebase-admin.ts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ==========================================
# NEO4J DATABASE
# ==========================================

# Bolt/Aura connection URI (src/lib/neo4j.ts).
NEO4J_URI=bolt://localhost:7687

# Both spellings are read (NEO4J_USERNAME in health checks, NEO4J_USER elsewhere).
NEO4J_USERNAME=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Client-side match-pulse graph features (src/features/match-pulse).
NEXT_PUBLIC_NEO4J_ENABLED=false
NEXT_PUBLIC_NEO4J_ENDPOINT=

# ==========================================
# SUPABASE (Database + Vector Search)
# ==========================================

# Project URL + anon key (src/config/vectorDbConfig.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key (KEEP SECRET, server-side only) — vector embeddings, admin ops.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Legacy aliases still read by scripts/ (inspect-supabase-schema.js, embeddings scripts).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ==========================================
# UPSTASH REDIS (Rate Limiting)
# ==========================================

# Without these, rate limiting falls back to in-memory (fine for local dev).
# UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ==========================================
# GCP / VERTEX AI
# ==========================================

# GCP project for Vertex AI, GCS and Secret Manager (falls back to the Firebase project id).
GCP_PROJECT_ID=
GCLOUD_PROJECT=
GCP_REGION=us-central1

# Path to a service-account key file, or the JSON inline (monitoring client).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GCP_SERVICE_ACCOUNT_KEY=

# Edge-runtime auth (src/lib/google-auth-edge.ts).
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_PRIVATE_KEY=

# Storage buckets for generated images and layers (all three names are read;
# default tatt-pro-assets).
GCP_STORAGE_BUCKET=
GCS_BUCKET=
GCS_BUCKET_NAME=

# Signed URL expiry in seconds (src/services/gcs-service.ts).
GCS_SIGNED_URL_EXPIRY=3600

# Vertex project for design-conversation providers.
VERTEX_PROJECT_ID=
NEXT_PUBLIC_VERTEX_AI_PROJECT_ID=

# Deployed segmentation endpoint id (src/lib/segmentation.ts).
VERTEX_SEGMENTATION_ENDPOINT_ID=

# Read only by scripts/deploy-api-gateway.sh (deployment-only).
CLOUD_RUN_URL=

# ==========================================
# AI GENERATION — models & providers
# ==========================================
# Routing between providers lives in src/config/modelRoutingRules.js.

# Replicate (server-side only). Both names are read; TOKEN is canonical.
# REPLICATE_API_TOKEN=r8_your_token_here
# REPLICATE_API_KEY=r8_your_token_here

# OpenRouter — https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-your_key_here
OPENROUTER_SITE_URL=https://tatttester.com

# LLM Council (src/services/council).
COUNCIL_API_URL=http://localhost:8001/api
NEXT_PUBLIC_COUNCIL_API_URL=http://localhost:8001/api

# Demo mode uses mock prompts without a council backend.
NEXT_PUBLIC_COUNCIL_DEMO_MODE=true
COUNCIL_USE_OPENROUTER=false
NEXT_PUBLIC_USE_OPENROUTER=false

# Default-on: anything but "false" enables the Vertex lane.
COUNCIL_VERTEX_AI_ENABLED=false
NEXT_PUBLIC_VERTEX_AI_ENABLED=false

# Model overrides (defaults live in code).
GEMINI_MODEL=
CONVERSATION_MODEL=
INTAKE_EXTRACTION_MODEL=

# Image model for the Vertex generation adapter
# (src/services/generation/internal/vertexImagen.ts — calls Gemini image models).
VERTEX_IMAGE_MODEL=gemini-3.1-flash-image

# Per-image list price fed to cost telemetry (not a billing path).
VERTEX_IMAGE_COST_USD=

# Used only by scripts/renderLanes.mjs.
IMAGEN_REPLICATE_SLUG=
IMAGEN_REPLICATE_COST_USD=

# Render text guard (#297/#305): screens every design-session render for
# lettering the request did not ask for, re-rolling once if found. Costs one
# vision call per image plus the occasional re-roll render. ON by default
# since the ADR-0048 routing switch (#318 measured 2/20 unsolicited
# lettering on the cast lane); set 'false' to opt out.
# RENDER_TEXT_GUARD=false
TEXT_GUARD_MODEL=

# Stencil derivation (src/services/designSession/internal/stencil.ts).
STENCIL_DERIVATION_ENABLED=false
STENCIL_PROMPT_STRENGTH=

# Optional override for the style ontology file (design conversation).
STYLE_ONTOLOGY_PATH=

# ==========================================
# VISION — reference-image analysis (TAT-50)
# ==========================================

# Vertex Gemini model for reading reference images (SMS media + web uploads).
VISION_MODEL=gemini-2.5-flash

# Flat cents recorded per analyzed image against the global budget (default 1 —
# a deliberate over-estimate; the real Gemini Flash call is a fraction of a cent).
VISION_ANALYSIS_COST_CENTS=1

# ==========================================
# BUDGET CONTROLS (src/lib/budget-tracker.ts)
# ==========================================

# Global hard cap on AI spend, in cents. Generation stops when exhausted.
BUDGET_MAX_SPEND_CENTS=50000

# Conversation turns metered per cent of budget.
CONVERSATION_TURNS_PER_CENT=

# Flat per-operation costs recorded against the budget, in cents.
VERTEX_IMAGEN_COST_CENTS=
COUNCIL_ENHANCE_COST_CENTS=
COUNCIL_PIPELINE_COST_CENTS=
EMBEDDING_COST_CENTS=
ESTIMATE_COST_CENTS=
LAYER_DECOMPOSE_BASE_COST_CENTS=
LAYER_DECOMPOSE_MASK_COST_CENTS=

# Free re-render ("fix") allowance per studio session (src/lib/studio-fix-allowance.ts).
STUDIO_FIX_ALLOWANCE=
NEXT_PUBLIC_STUDIO_FIX_ALLOWANCE=

# ==========================================
# STRIPE — Payments, Connect, Billing, Tax, Invoicing, Radar
# ==========================================

# Server-side secret key (test: sk_test_...); server only — routes fail closed (503) if unset/placeholder.
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER

# Publishable key — safe to expose (Stripe.js). Documented but not yet
# read by code (reserved for client-side Stripe.js / embedded components).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER

# Webhook signing secret for the main endpoint (whsec_...). Placeholder → webhook fails closed (503).
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

# Optional: separate signing secret if Connect events use their own webhook endpoint.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Non-prod ONLY escape hatch to accept unverified webhooks (never set in production).
STRIPE_WEBHOOK_ALLOW_PLACEHOLDER=false

# Platform take-rate on marketplace transactions, in basis points (1000 = 10%).
PLATFORM_FEE_BPS=1000

# Recurring Price id for the artist SaaS subscription (price_...). Create in the Stripe dashboard.
STRIPE_PRICE_ARTIST_SUB=

# Price id for consumer credit packs (src/app/api/v1/billing/credits/route.ts).
STRIPE_PRICE_CONSUMER_CREDITS=

# Currency for charges/invoices (default usd).
STRIPE_CURRENCY=usd

# Days a deposit for an unclaimed artist is held before it's auto-refunded (default 7).
DEPOSIT_HOLD_DAYS=7

# Bearer secret the Vercel cron uses to authenticate the scheduled endpoints (expire-deposits, session-review).
CRON_SECRET=

# ==========================================
# GOOGLE CALENDAR — per-artist availability sync (docs/google-calendar-setup.md)
# ==========================================

# OAuth client id — unset ⇒ every artist stays on booking requests.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# OAuth client secret — server only.
GOOGLE_OAUTH_CLIENT_SECRET=

# base64 of 32 random bytes; seals every artist's refresh token.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Write-back to an app-created calendar; false everywhere until deliberate.
GOOGLE_CALENDAR_WRITE_ENABLED=false

# ==========================================
# INSTAGRAM — artist-authorized portfolios
# ==========================================
# Create/configure the Meta app in the Instagram API product, and allow:
#   https://tatttester.com/api/v1/artist/instagram/callback
# The secret is server-only. Never prefix it with NEXT_PUBLIC_.

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ==========================================
# PORTFOLIO DISPLAY FLAGS
# ==========================================

# Kill switch for displaying scraped portfolio images (TAT-31).
# Server-side only (deliberately NOT NEXT_PUBLIC_). Unset or any value other
# than "false" = current behavior (images shown). Set to "false" to stop
# displaying portfolio images for UNCLAIMED artists everywhere (roster cards,
# artist profiles, match results); claimed artists' images always show.
# Flipping this is a counsel/human decision. See src/lib/portfolio-display.ts.
SHOW_UNCLAIMED_PORTFOLIOS=true

# Instagram embed tier for unclaimed artists (TAT-40).
# Server-side only (deliberately NOT NEXT_PUBLIC_). Default off: only the
# literal "true" enables. When on, an UNCLAIMED artist's profile page (and
# only the profile page — card grids never mount iframes) renders official
# Instagram embeds from the permalinks on the :Artist node instead of hosted
# scraped copies; the media stays served by Meta, nothing is cached on TatT.
# Claimed artists always show their licensed hosted images instead.
# See src/lib/portfolio-display.ts and src/components/punk/InstagramEmbed.tsx.
ENABLE_IG_EMBEDS=false

# ==========================================
# TWILIO — SketchBot SMS channel (TAT-49, docs/sketchbot-sms-setup.md)
# ==========================================

# Master flag: anything but "true" makes /api/webhooks/twilio answer 404.
SKETCHBOT_SMS_ENABLED=false

# Account SID (AC...). Server-side only.
TWILIO_ACCOUNT_SID=

# Auth token — verifies X-Twilio-Signature (required; API keys cannot substitute here).
TWILIO_AUTH_TOKEN=

# Purchased number, E.164. Outbound sender when no Messaging Service is set.
TWILIO_PHONE_NUMBER=

# The EXACT webhook URL configured on the number/Messaging Service — the
# signature is HMAC'd over this string byte-for-byte, so it must match the
# Twilio console verbatim (scheme, host, path, no trailing slash). Unset ⇒
# derived from NEXT_PUBLIC_APP_URL + /api/webhooks/twilio.
TWILIO_WEBHOOK_URL=https://tatttester.com/api/webhooks/twilio

# Optional Messaging Service SID (MG...) — replaces "from" on sends.
TWILIO_MESSAGING_SERVICE_SID=

# Optional API key pair for outbound sends (falls back to the auth token).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Spend guardrails (env-tunable; see the setup doc for the math).
SKETCHBOT_SMS_REVEALS_PER_DAY=2
SKETCHBOT_SMS_FREE_REVEALS=2
SKETCHBOT_SMS_MSGS_PER_HOUR=30

# Non-prod ONLY escape hatch to accept unsigned webhooks (never set in production).
SKETCHBOT_SMS_ALLOW_UNSIGNED=false

# Published SketchBot number rendered on the site (public, not a secret).
NEXT_PUBLIC_SKETCHBOT_SMS_NUMBER=

# ==========================================
# EMAIL (Resend — src/services/emailQueueService.js)
# ==========================================

RESEND_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_URL=

# Ops inbox notified about new artist intros.
OPS_NOTIFY_EMAIL=

# ==========================================
# SCRIPTS / DATA ACQUISITION (not needed to run the app)
# ==========================================

# scripts/data_acquisition crawlers.
GOOGLE_PLACES_API_KEY=
BROWSERACT_API_KEY=
CRAWLER_LIMIT=
CRAWLER_TOTAL_LIMIT=

# execution/ Python scrapers.
APIFY_TOKEN=

# Verbose logging in the embedding scripts (scripts-only).
DEBUG_EMBEDDINGS=

# Optional Cypher clause override for scripts/castCorpus.mjs (scripts-only).
CAST_CLAUSE=

# Legacy embedding scripts (scripts/generate-portfolio-embeddings.js,
# scripts/inject-supabase-data.js) still read these VITE_-prefixed names.
VITE_SUPABASE_URL=
VITE_PROXY_URL=
FRONTEND_AUTH_TOKEN=
VITE_FRONTEND_AUTH_TOKEN=

# CI/deploy-only (set as GitHub Actions secrets, never in a local .env):
# CLAUDE_CODE_OAUTH_TOKEN, WIF_PROVIDER, WIF_SERVICE_ACCOUNT.
